# Application
AUTO_TRADING_V2_ENVIRONMENT=development
AUTO_TRADING_V2_LOG_LEVEL=INFO

# MSSQL runtime provider (local development and paper trading only)
AUTO_TRADING_V2_DB_PROVIDER=dotnet
AUTO_TRADING_V2_MSSQL_HOST=localhost
AUTO_TRADING_V2_MSSQL_PORT=1433
AUTO_TRADING_V2_MSSQL_DATABASE=auto_trading_v2
AUTO_TRADING_V2_MSSQL_USERNAME=
AUTO_TRADING_V2_MSSQL_PASSWORD=
AUTO_TRADING_V2_MSSQL_ENCRYPT=false
AUTO_TRADING_V2_MSSQL_TRUST_SERVER_CERTIFICATE=true
AUTO_TRADING_V2_MSSQL_CONNECT_TIMEOUT=5

# Legacy SQLAlchemy/Alembic administration (not used by the DotNet runtime)
AUTO_TRADING_V2_MSSQL_ADMIN_URL=
AUTO_TRADING_V2_DATABASE_URL=
AUTO_TRADING_V2_TEST_ADMIN_URL=

# KIS paper
AUTO_TRADING_V2_KIS_ENABLED=false
AUTO_TRADING_V2_KIS_ENVIRONMENT=paper
AUTO_TRADING_V2_KIS_BASE_URL=
AUTO_TRADING_V2_KIS_APP_KEY=
AUTO_TRADING_V2_KIS_APP_SECRET=
AUTO_TRADING_V2_KIS_ACCOUNT_NUMBER=
AUTO_TRADING_V2_KIS_ACCOUNT_PRODUCT_CODE=

# Telegram
AUTO_TRADING_V2_TELEGRAM_ENABLED=false
AUTO_TRADING_V2_TELEGRAM_BOT_TOKEN=
